# ==========================================
# Multi-Agent Procurement System Environment
# ==========================================

# LLM Provider Configuration
# Supported providers: openrouter, openai, anthropic, ollama, azure
LLM_PROVIDER=openrouter
LLM_MODEL=openrouter/stealth/ox-alpha
LLM_TEMPERATURE=0.0
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_API_BASE=https://openrouter.ai/api/v1

# OpenAI Configuration (Optional / Alternative)
OPENAI_API_KEY=your_openai_api_key_here

# Embedding Configuration (For Knowledge Sources)
EMBEDDING_PROVIDER=openrouter
EMBEDDING_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2:free

# Search Engine Configuration
# Supported search providers: tavily, mock
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=your_tavily_api_key_here

# Web Scraping Configuration
# Supported scraping providers: scrapegraph, mock
SCRAPER_PROVIDER=scrapegraph
SCRAPEGRAPH_API_KEY=your_scrapegraph_api_key_here

# Observability & Tracing
# Set to true to enable AgentOps tracking
AGENTOPS_ENABLED=true
AGENTOPS_API_KEY=your_agentops_api_key_here

# Application Configuration
APP_ENV=development
LOG_LEVEL=INFO
OUTPUT_DIR=./outputs

# FastAPI Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
